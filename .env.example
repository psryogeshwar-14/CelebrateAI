# ============================================================================
# CelebrateAI Environment Configuration
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API (Server-side API routes only via @google/genai)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Postgres & Auth
# Client-accessible variables (Public):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only Admin Service Role Key (NEVER expose to browser runtime)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo Mode Configuration
ENABLE_AUTO_SEED_DEMO=true
